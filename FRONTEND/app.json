{
  "expo": {
    "name": "VYLNAX",
    "slug": "vylnax",
    "version": "0.2.1",

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vylnax",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vylnax.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "VYLNAX benötigt die Spracherkennung für den KI-Assistenten.",
        "NSMicrophoneUsageDescription": "VYLNAX benötigt Zugriff auf das Mikrofon für die Sprachsteuerung."
      }
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.vylnax.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },

    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "VYLNAX benötigt die Kamera zum Scannen von Medikamenten-Barcodes und Rezepten."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-notifications",
      [
        "@jamsch/expo-speech-recognition",
        {
          "microphonePermission": "VYLNAX benötigt Zugriff auf das Mikrofon für die Sprachsteuerung.",
          "speechRecognitionPermission": "VYLNAX benötigt die Spracherkennung für den KI-Assistenten."
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "fbdb9d79-e419-4090-9184-92fb9bced338"
      }
    },

    "updates": {
      "url": "https://u.expo.dev/fbdb9d79-e419-4090-9184-92fb9bced338"
    }
  }
}